{
  "name": "helen-runner",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "check": "concurrently \"tsc --noEmit\" \"npm run format:check\" \"npm run test\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ai": "^4.3.16",
    "@ai-sdk/google": "^1.2.19",
    "@ai-sdk/openai": "^1.3.22",
    "@ai-sdk/anthropic": "^1.2.12",
    "@openrouter/ai-sdk-provider": "^0.4.5",
    "ollama-ai-provider": "^1.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0-dev.20250528",
    "tsx": "^4.19.4",
    "vitest": "^3.1.4",
    "@vitest/coverage-v8": "^3.1.4",
    "prettier": "^3.5.3",
    "@types/node": "^22.15.21",
    "concurrently": "^9.1.2"
  }
}
